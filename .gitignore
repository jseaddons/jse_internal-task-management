# live database and backups - never commit
*.db
*.db-journal
*.db-wal
*.bulk_before_*
*.role_before_*
backups/

# generated report output
reports*.xlsx
manday_*.xlsx
forecast_*.xlsx

# python
__pycache__/
*.pyc

